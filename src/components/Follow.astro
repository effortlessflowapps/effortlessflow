---
const socials = [
  {
    name: 'Instagram',
    handle: '@effortlessflowapps',
    href: 'https://www.instagram.com/effortlessflowapps',
    note: 'Behind the scenes, sketches, and the face of it all.',
    icon: 'instagram',
  },
  {
    name: 'X',
    handle: '@eflowapps',
    href: 'https://x.com/eflowapps',
    note: 'Product thinking, half-formed ideas, and the occasional build note.',
    icon: 'x',
  },
  {
    name: 'LinkedIn',
    handle: 'EffortlessFlow',
    href: 'https://www.linkedin.com/company/effortlessflow',
    note: 'The company story, milestones, and the longer-form thinking.',
    icon: 'linkedin',
  },
];
---

<section class="section follow" id="follow">
  <div class="container">
    <div class="follow__head">
      <h2 class="follow__title">
        Surely there's <span class="follow__accent">a better way</span>.
      </h2>
      <p class="follow__lede">
        That's the question behind everything built here, and the honest
        answer is still being written, one app at a time. Follow along to watch
        the wins, the restarts, and the thinking in between. Help shape what
        comes next.
      </p>
    </div>
    <ul class="follow__cards">
      {
        socials.map((s) => (
          <li>
            <a class="follow__card" href={s.href} rel="me noopener" target="_blank">
              <span class="follow__icon" aria-hidden="true">
                {s.icon === 'instagram' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="26" height="26">
                    <rect x="3" y="3" width="18" height="18" rx="5.5" />
                    <circle cx="12" cy="12" r="4.2" />
                    <circle cx="17.3" cy="6.7" r="1.15" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {s.icon === 'x' && (
                  <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                    <path d="M17.9 3H21l-6.8 7.8L22.2 21h-6.3l-4.9-6.4L5.4 21H2.3l7.3-8.3L2 3h6.4l4.4 5.9L17.9 3zm-1.1 16.1h1.7L7.6 4.8H5.8l11 14.3z" />
                  </svg>
                )}
                {s.icon === 'linkedin' && (
                  <svg viewBox="0 0 24 24" fill="currentColor" width="24" height="24">
                    <path d="M6.4 8.9H3V21h3.4V8.9zM4.7 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM12 12.9c0-1.3.6-2.6 2.4-2.6 1.7 0 2.2 1.2 2.2 2.9V21H20v-6.7c0-3.4-1.8-5-4.3-5-2 0-3.1 1.1-3.7 2.1V8.9H8.6c0 1 0 12.1 0 12.1H12v-8.1z" />
                  </svg>
                )}
              </span>
              <span class="follow__name">{s.name}</span>
              <span class="follow__handle">{s.handle}</span>
              <span class="follow__note">{s.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .follow {
    border-block: 1px solid var(--ef-line-soft);
  }

  .follow__head {
    max-width: 42rem;
    margin-bottom: 3rem;
  }

  .follow__title {
    margin-bottom: 0.4em;
    font-size: clamp(2.5rem, 5.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--ef-forest);
  }

  .follow__accent {
    color: var(--ef-orange);
  }

  .follow__lede {
    color: var(--ef-ink-soft);
    font-size: clamp(1.08rem, 1.5vw, 1.2rem);
  }

  .follow__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
    gap: 1.25rem;
  }

  .follow__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    height: 100%;
    padding: 1.6rem 1.5rem 1.4rem;
    background: #fff;
    border: 1.5px solid var(--ef-line);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .follow__card:hover {
    border-color: var(--ef-forest);
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px rgb(1 68 38 / 45%);
  }

  .follow__icon {
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    background: var(--ef-forest-wash);
    color: var(--ef-forest);
    margin-bottom: 0.8rem;
  }

  .follow__card:hover .follow__icon {
    background: var(--ef-forest);
    color: var(--ef-canvas);
  }

  .follow__name {
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--ef-ink);
  }

  .follow__handle {
    font-weight: 700;
    font-size: var(--fs-small);
    color: var(--ef-ink-soft);
  }

  .follow__note {
    margin-top: 0.55rem;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--ef-ink-soft);
  }
</style>
