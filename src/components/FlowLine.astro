---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 720 90"
  fill="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M8 62 C 120 88, 235 30, 355 45 C 475 60, 545 82, 660 44"
    stroke="var(--ef-orange)"
    stroke-width="4.5"
    stroke-linecap="round"></path>
  <path
    d="M676 38 c 6 3, 9 9, 7 15"
    stroke="var(--ef-orange)"
    stroke-width="4.5"
    stroke-linecap="round"></path>
  <circle cx="700" cy="34" r="6.5" fill="var(--ef-orange)"></circle>
</svg>
